      "uid": {
        "config": {
          "label": "UID"
        },
        "type": "UID"
      },
      "slices": {
        "config": {
          "choices": {}
        },
        "fieldset": "Slice Zone",
        "type": "Slices"
      },
      "title": {
        "config": {
          "label": "Título"
        },
        "type": "Text"
      },
      "featured_image": {
        "config": {
          "label": "Foto principal"
        },
        "type": "Image"
      },
      "excerpt": {
        "config": {
          "label": "Excerpt"
        },
        "type": "Text"
      },
      "body": {
        "config": {
          "label": "Contenido",
          "multi": "paragraph,heading2,heading3,strong,em,hyperlink,list-item,o-list-item"
